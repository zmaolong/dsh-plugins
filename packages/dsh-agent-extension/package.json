{
  "name": "dsh-agent-extension",
  "version": "0.0.1-preview.1",
  "description": "Agent Extension (智能体扩展) for DSH: manage agent plugins, skills, MCP and more — hosts Claude Code / CodeBuddy / ZCode agent plugins as DSH skills, commands, hooks and MCP, with a ZCode-style store panel.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "check": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build": "tsdown",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "clsx": "^2.1.1",
    "jsdom": "29.1.1",
    "lightningcss": "^1.33.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zmaolong/dsh-plugins.git",
    "directory": "packages/dsh-agent-extension"
  },
  "homepage": "https://github.com/zmaolong/dsh-plugins/tree/release-0.0.1/packages/dsh-agent-extension",
  "bugs": {
    "url": "https://github.com/zmaolong/dsh-plugins/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "preview"
  },
  "keywords": [
    "dsh-plugin",
    "agent-extension",
    "claude",
    "codebuddy",
    "zcode",
    "marketplace",
    "web-ui"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    },
    "market": {
      "title": {
        "en": "Agent Extension",
        "zh-cn": "智能体扩展"
      },
      "description": {
        "en": "Manage agent extensions in DSH — agent plugins, skills, MCP servers and more: personal marketplaces, install/update/rollback, per-item capability toggles, and a ZCode-style store panel.",
        "zh-cn": "在 DSH 里管理智能体扩展（插件、技能、MCP 等）：个人市场源、安装/更新/回滚、能力逐项启停，以及 ZCode 风格商店面板。"
      },
      "category": "tool",
      "keywords": [
        "agent-extension",
        "claude",
        "codebuddy",
        "zcode",
        "marketplace",
        "store"
      ]
    }
  }
}
