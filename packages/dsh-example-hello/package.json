{
  "name": "dsh-example-hello",
  "version": "0.1.0",
  "description": "A minimal DeepSeek Harness plugin that only logs when it loads.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "README.md",
    "package.json"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "market": {
      "title": { "en": "Example Hello", "zh-cn": "示例：问候" },
      "description": {
        "en": "The smallest possible DSH plugin: one module, one row, one log line.",
        "zh-cn": "最小的 DSH 插件：一个模块、一行配置、一行日志。"
      },
      "category": "tool",
      "labels": ["example"],
      "keywords": ["example", "hello"]
    }
  }
}