{
  "name": "dsh-remote-ctrl",
  "version": "0.0.1-preview.5",
  "description": "Remote Control (远程控制) for DSH: a pairing-token LAN gateway that reverse-proxies the full, responsive DSH web UI to phones on the local network.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "check": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build": "tsdown",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "clsx": "^2.1.1",
    "jsdom": "29.1.1",
    "lightningcss": "^1.33.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zmaolong/dsh-plugins.git",
    "directory": "packages/dsh-remote-ctrl"
  },
  "homepage": "https://github.com/zmaolong/dsh-plugins/tree/release-0.0.1/packages/dsh-remote-ctrl",
  "bugs": {
    "url": "https://github.com/zmaolong/dsh-plugins/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "preview"
  },
  "keywords": [
    "dsh-plugin",
    "remote-control",
    "mobile",
    "lan",
    "gateway",
    "qr"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    },
    "market": {
      "title": {
        "en": "Remote Control",
        "zh-cn": "远程控制"
      },
      "description": {
        "en": "A pairing-token LAN gateway that reverse-proxies the full, responsive DSH web UI to phones on the local network — sessions, streaming output, approvals and questions all native. QR-code pairing, all LAN addresses reachable.",
        "zh-cn": "局域网访问网关：扫码即得完整、自适应的 DSH Web UI（会话、流式输出、工具审批、智能体提问全部原生）。配对码鉴权，所有局域网地址均可访问。"
      },
      "category": "tool",
      "keywords": [
        "remote-control",
        "mobile",
        "lan",
        "gateway",
        "qr"
      ]
    }
  }
}
