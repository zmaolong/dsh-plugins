{
  // Host half: server modules (src/*.ts) and the node-side specs that drive
  // them. Runs under plain node after tsdown emits lib/index.js. The mobile
  // page (src/mobile) is browser code owned by the client program; its pure
  // model module is still importable from specs here (it must stay DOM-free).
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2024"],
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "tsdown.config.ts", "vitest.config.ts"],
  "exclude": ["src/client", "src/mobile/main.ts", "tests/**/*.client.spec.ts", "tests/**/*.client.spec.tsx"]
}
