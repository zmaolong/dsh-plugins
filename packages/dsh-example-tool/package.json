{
  "name": "dsh-example-tool",
  "version": "0.1.0",
  "description": "A DeepSeek Harness plugin that registers one model-facing tool.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "README.md",
    "package.json"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "market": {
      "title": { "en": "Example Tool", "zh-CN": "示例：自定义工具" },
      "description": {
        "en": "Registers a hello_tool the model can call; shows the tool registration shape.",
        "zh-CN": "注册一个模型可调用的 hello_tool，演示工具注册写法。"
      },
      "category": "tool",
      "labels": ["example"],
      "keywords": ["example", "tool"]
    }
  }
}