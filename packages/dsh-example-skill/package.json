{
  "name": "dsh-example-skill",
  "version": "0.1.0",
  "description": "A DeepSeek Harness plugin that ships one bundled skill.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "package.json"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "market": {
      "title": { "en": "Example Skill", "zh-CN": "示例：内置技能" },
      "description": {
        "en": "Ships an example-greeting skill from an asset Markdown file.",
        "zh-CN": "从 assets 里的 Markdown 提供一条 example-greeting 技能。"
      },
      "category": "skill",
      "labels": ["example"],
      "keywords": ["example", "skill"]
    }
  }
}